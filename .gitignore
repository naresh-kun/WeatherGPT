# ============================================================
# WeatherGPT — Root .gitignore
# ============================================================

# ---- Secrets & environment --------------------------------
.env
*.env
!.env.example

# ---- Python -----------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
dist/
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage

# ---- Flutter / Dart ---------------------------------------
.dart_tool/
build/
*.g.dart
*.freezed.dart
*.mocks.dart
pubspec.lock

# ---- IDE & editors ----------------------------------------
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db

# ---- Logs -------------------------------------------------
*.log
logs/

# ---- Data (keep structure, ignore large files) ------------
data/historical/*
data/sample/*
!data/historical/.gitkeep
!data/sample/.gitkeep
