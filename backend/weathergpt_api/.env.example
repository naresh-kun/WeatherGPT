# WeatherGPT API — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit a .env file with real secrets to version control.

# ---- Weather Data Provider -----------------------------------
WEATHER_API_KEY=
WEATHER_BASE_URL=https://api.weatherapi.com/v1
WEATHER_API_TIMEOUT=15

# ---- LLM / Gemini Provider -----------------------------------
# GEMINI_API_KEY: Get one at https://aistudio.google.com/
GEMINI_API_KEY=
LLM_API_KEY=
# GEMINI_MODEL defaults to gemini-3.7-flash — override here if needed
# GEMINI_MODEL=gemini-3.7-flash

# ---- Application Settings ------------------------------------
DEBUG=false
HOST=0.0.0.0
PORT=8000
